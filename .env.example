# ==============================================================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# ==============================================================================

# Banco de dados
POSTGRES_USER=peertube
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=peertube

PEERTUBE_DB_USERNAME=peertube
PEERTUBE_DB_PASSWORD=troque_por_uma_senha_forte
PEERTUBE_DB_HOSTNAME=postgres
PEERTUBE_DB_NAME=peertube
PEERTUBE_DB_SSL=false

# Servidor
# Para uso local adicione ao hosts: 127.0.0.1 peertube.localhost
PEERTUBE_WEBSERVER_HOSTNAME=peertube.localhost
PEERTUBE_WEBSERVER_PORT=9000
PEERTUBE_WEBSERVER_HTTPS=false

# Gere com: openssl rand -hex 32
# No PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
PEERTUBE_SECRET=gere_e_cole_sua_chave_aqui

PEERTUBE_TRUST_PROXY=["127.0.0.1", "loopback", "172.18.0.0/16"]

# E-mail (desabilitado para uso local)
PEERTUBE_SMTP_HOSTNAME=localhost
PEERTUBE_SMTP_PORT=25
PEERTUBE_SMTP_FROM=noreply@peertube.localhost
PEERTUBE_SMTP_TLS=false
PEERTUBE_SMTP_DISABLE_STARTTLS=true
PEERTUBE_ADMIN_EMAIL=admin@peertube.localhost
